{
  "name": "gatinho-online",
  "version": "1.1.29",
  "private": true,
  "description": "Luna's Life - multiplayer online",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.luna.life",
    "productName": "Luna's Life",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "server.js",
      "chat-guard.js",
      "config.json",
      "icon.png",
      "public/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LunasLife.exe"
    }
  }
}
